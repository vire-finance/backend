# PostgreSQL is required. Use a dedicated development database.
DATABASE_URL=postgresql+psycopg://vire:development-password@localhost:5432/vire
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-locally-generated-random-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=5242880
OCR_TIMEOUT_SECONDS=30
OCR_MAX_IMAGE_PIXELS=25000000
# Optional: absolute executable path if Tesseract is not on PATH.
TESSERACT_CMD=
TESSDATA_PREFIX=
# Optional self-hosted open-weight interpretation. No inference by default.
# LLM_BASE_URL is the Ollama server root (without /api/chat).
# Example configuration after installing a commercially permitted model:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen2.5:7b-instruct
# Remote providers require HTTPS. No proprietary API adapter is included.
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=30
# Backward-compatible full Ollama /api/chat URL; BASE_URL takes precedence.
# Legacy ENDPOINT opt-in works when LLM_PROVIDER is not set.
LLM_ENDPOINT=
AI_INSIGHT_CACHE_TTL_SECONDS=300
AI_INSIGHT_FAILURE_TTL_SECONDS=30
AI_SPENDING_INCREASE_PERCENT=25
AI_HIGH_UTILIZATION_PERCENT=80
AI_CONCENTRATION_PERCENT=60
AI_LARGE_TRANSACTION_MULTIPLIER=2
AI_MIN_BASELINE_TRANSACTIONS=3
