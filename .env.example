# Shareable template only. Copy to .env and replace required placeholders privately.
# Default: development. Set APP_ENV=production in Render, not in teammates' local files.
# Development requires DEV_DATABASE_URL and SECRET_KEY.
# Production requires PROD_DATABASE_URL, SECRET_KEY, PROD_LLM_API_KEY, SUPABASE_URL and SUPABASE_SECRET_KEY.
# Configure production providers/models, frontend CORS and Linux OCR runtime before deploying.

# Application Environment
# APP_ENV selects DEV_* database/Ollama and local files, or PROD_* database/Groq and private Supabase Storage.
# Render environment variables override this local file.
APP_ENV=development

# Database (Development / Production)
# Keep development and production credentials separate; never share this file.
DEV_DATABASE_URL=<development-postgresql-connection-string>
PROD_DATABASE_URL=<production-postgresql-connection-string>
DATABASE_URL=

# Authentication & Security
# Use a strong, stable backend signing secret; rotating it invalidates signed tokens.
SECRET_KEY=<generate-a-unique-random-backend-signing-secret>

# Firebase / Google Authentication
# GOOGLE_CLIENT_ID enables Google login. Firebase settings enable push delivery.
# FIREBASE_SERVICE_ACCOUNT is a private JSON file path, not inline JSON.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
GOOGLE_CLIENT_ID=

# AI / LLM (Development / Production)
# Production uses Groq. An empty PROD_LLM_BASE_URL uses the built-in Groq endpoint.
# If supplied, PROD_LLM_BASE_URL must be the full HTTPS chat-completions endpoint.
# DATABASE_URL and generic LLM connection settings are derived from APP_ENV.
DEV_LLM_PROVIDER=ollama
PROD_LLM_PROVIDER=groq
DEV_LLM_MODEL=qwen3:1.7b
PROD_LLM_MODEL=<supported-groq-model-id>
DEV_LLM_BASE_URL=http://localhost:11434
PROD_LLM_BASE_URL=
PROD_LLM_API_KEY=<backend-only-groq-api-key>
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_PROVIDER=
LLM_BASE_URL=
LLM_THINKING=false
LLM_TIMEOUT=30
LLM_MAX_OUTPUT_TOKENS=300
LLM_NUM_THREADS=4
LLM_KEEP_ALIVE=5m
AI_INSIGHT_CACHE_TTL_SECONDS=300
AI_INSIGHT_FAILURE_TTL_SECONDS=30
AI_SPENDING_INCREASE_PERCENT=25
AI_HIGH_UTILIZATION_PERCENT=80
AI_CONCENTRATION_PERCENT=60
AI_LARGE_TRANSACTION_MULTIPLIER=2
AI_MIN_BASELINE_TRANSACTIONS=3
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=

# Supabase Storage
# SUPABASE_SECRET_KEY is backend-only; the receipts bucket must remain private.
# SUPABASE_PUBLISHABLE_KEY and SUPABASE_JWKS_URL are retained but not read by this backend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=<backend-only-supabase-secret-or-service-role-key>
STORAGE_TIMEOUT_SECONDS=15
# Retained compatibility variable; not currently read by Settings.
SUPABASE_JWKS_URL=
# Retained compatibility variable; not currently read by Settings.
SUPABASE_PUBLISHABLE_KEY=

# OCR / Tesseract
# Windows executable paths are local-only. Render needs installed Tesseract and Linux paths.
# Production receipts use Storage; UPLOAD_DIR is the development file directory.
TESSERACT_CMD=
TESSDATA_PREFIX=
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=5242880
OCR_TIMEOUT_SECONDS=30
OCR_MAX_IMAGE_PIXELS=25000000
OCR_MAX_CONCURRENT_JOBS=2
OCR_JOB_TIMEOUT_SECONDS=90
OCR_STALE_JOB_SECONDS=600

# CORS & Networking
# CORS_ORIGINS is a JSON array. Render needs the actual deployed frontend origins.
# PORT is supplied by Render and must be passed to the server start command.
HTTP_MAX_JSON_BODY_BYTES=262144
HTTP_MULTIPART_OVERHEAD_BYTES=65536
HTTP_BODY_TIMEOUT_SECONDS=30
HTTP_MAX_CONCURRENT_UPLOADS=2
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://127.0.0.1:8080","http://localhost:5070"]

# Other Application Settings
# Settings omitted from this file continue to use application defaults.
RATE_LOGIN_REQUESTS_PER_MINUTE=20
RATE_UPLOAD_REQUESTS_PER_MINUTE=20
RATE_AI_REQUESTS_PER_MINUTE=6
